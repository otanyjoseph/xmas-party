rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only you (the admin account) can change slot counts.
    // Replace the string with your admin user's UID (Firebase console → Authentication → Users).
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'PASTE_YOUR_ADMIN_UID_HERE';
    }

    function validDish() {
      let d = request.resource.data;
      return d.keys().hasOnly(['c','k','n','b','note','ts'])
        && d.c in ['app','main','drink','dessert']
        && d.k in ['veg','nonveg','alc','non']
        && d.n is string && d.n.size() > 0 && d.n.size() <= 60
        && d.b is string && d.b.size() > 0 && d.b.size() <= 40
        && d.note is string && d.note.size() <= 200
        && d.ts is number;
    }

    // Guests: anyone with the link can see, add, edit and remove dishes (as you chose).
    match /dishes/{id} {
      allow read: if true;
      allow create, update: if validDish();
      allow delete: if true;
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
